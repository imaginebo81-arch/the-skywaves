# Server
NODE_ENV="development"
PORT="3000"

# Supabase (server-side only, never expose with a VITE_ prefix)
SUPABASE_URL="https://YOUR-KONG-OR-SUPABASE-URL"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="skywaves"
SUPABASE_DB_SCHEMA="skywaves"

# Admin auth
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_COOKIE_NAME="skw_admin"
JWT_EXPIRES_IN="8h"
RESULT_TOKEN_TTL_SECONDS="600"

# Seed script only (used by `npm run seed`)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-strong-password"

# Migration only (direct Postgres connection used by `npm run db:migrate`)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/postgres"
